[Unit]
Description=zlb nftables load balancer node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/zlb
ExecStart=/usr/bin/python3 -m zlb.natd --listen 10.0.0.1 --token-file /etc/zlb/token --ip 198.51.100.10 --public-interface eth0 --node-cidr 10.0.0.0/24
ExecStopPost=/usr/bin/python3 -m zlb.natd --cleanup --listen 10.0.0.1 --ip 198.51.100.10 --public-interface eth0 --node-cidr 10.0.0.0/24
Restart=on-failure
RestartSec=2
RuntimeDirectory=zlb
RuntimeDirectoryMode=0700
StateDirectory=zlb
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
