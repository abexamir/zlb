{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "lbNode": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^/ ]+"
        },
        "allowPrivateHTTP": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        },
        "clientCertSecret": {
          "type": "string"
        }
      }
    },
    "nodeCIDR": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
    },
    "interval": {
      "type": "number",
      "minimum": 1
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "backendPortRange": {
          "type": "string",
          "pattern": "^[0-9]{1,5}-[0-9]{1,5}$"
        },
        "schedule": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string"
        },
        "requireClientCertificates": {
          "type": "boolean"
        },
        "apiAllowFrom": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]+$"
          }
        },
        "allowForeignForwarding": {
          "type": "boolean"
        },
        "isolatePublicIPs": {
          "type": "boolean"
        }
      }
    },
    "pools": {
      "type": "object",
      "required": [
        "default_pool",
        "pools"
      ],
      "properties": {
        "default_pool": {
          "type": "string"
        },
        "pools": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "restrictServiceWrites": {
          "type": "boolean"
        }
      }
    }
  },
  "not": {
    "required": [
      "gateway"
    ]
  }
}
